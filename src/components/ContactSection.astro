---
import Icon from './Icon.astro';
import EmailLink from './EmailLink.astro';
import type { Lang } from '../lib/content';
import { contactCopy } from '../lib/contact';
import '../styles/contact.css';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = contactCopy[lang];
---
<section class="contact-section" id="contact-us" aria-labelledby="contact-heading">
  <header class="contact-heading">
    <div><h2 id="contact-heading">CONTACT US</h2><p>{copy.heading}</p></div>
    <span class="contact-decoration" aria-hidden="true"><Icon name="heart" /><span></span><Icon name="heart" /></span>
  </header>
  <div class="contact-links">
    <a class="contact-link contact-link-github" href="https://github.com/MqyGalaxy" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><Icon name="github" /></span><span class="contact-copy"><strong>GitHub</strong><span data-original-font="body">MqyGalaxy</span></span></a>
    <EmailLink lang={lang} class="contact-link contact-link-email"><span class="contact-icon"><Icon name="mail" /></span><span class="contact-copy"><strong>Email</strong><span>{copy.send}</span></span></EmailLink>
    <a class="contact-link contact-link-bilibili" href="https://space.bilibili.com/147114872" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><Icon name="bilibili" /></span><span class="contact-copy"><strong>bilibili</strong><span>七羽_MqyGalaxy</span></span></a>
    <a class="contact-link contact-link-music" href="https://music.163.com/#/user/home?id=431446496" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><Icon name="music" /></span><span class="contact-copy"><strong>{copy.music}</strong><span>七羽_MqyGalaxy</span></span></a>
  </div>
  <noscript><p class="contact-fallback">{copy.fallback}</p></noscript>
</section>
