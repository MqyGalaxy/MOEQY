# Dependencies and package-manager caches (keep package-lock.json)
node_modules/
.npm/
.pnpm-store/

# Astro build output and generated caches
/dist/
/.astro/
.cache/
.vite/
*.tsbuildinfo

# Environment variables and local credentials
.env
.env.*
!.env.example
!.env.sample
!.env.template
# Example files above must contain placeholders only.
.npmrc
.netrc
.ssh/
.aws/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
service-account*.json
serviceAccountKey*.json

# Local content-studio state, backups, and interrupted writes
.content-studio/
*.tmp
*.temp
*.bak
*.orig
*~

# Design originals and previews; published assets live in public/
/design/

# Logs and test reports
*.log
logs/
coverage/
.nyc_output/
playwright-report/
test-results/

# Local deployment state
.vercel/
.netlify/
.wrangler/

# Editor settings and local AI-tool state
.idea/
.vscode/
*.swp
*.swo
.history/
.codex/

# Python caches from design utility scripts
__pycache__/
*.py[cod]
.venv/

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
