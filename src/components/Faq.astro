---
import Icon from './Icon.astro';
import originalFaq from '../data/faq.json';
import japaneseFaq from '../data/faq-ja.json';
import PageHeading from './PageHeading.astro';
import { ui, link, type Lang } from '../lib/content';
interface Props { lang: Lang; }
const { lang }=Astro.props; const en=lang==='en';
const faq = lang === 'ja' ? japaneseFaq : originalFaq;
const englishTitles=['Home','Videos','Privacy','Feedback','Other'];
---
<PageHeading mascot="thinking" title="FAQ" subtitle={ui(lang, 'Frequently Asked Questions and Answers', '常见问题与解答')} eyebrow="A LITTLE HELP, WHEN YOU NEED IT" />
<div class="document-wrap">{en && <div class="document-aside">These original answers are available in Simplified Chinese. <a href={link(lang,'help/translate')}>Help us translate <Icon name="arrow" direction="up-right" /></a></div>}<div class="faq-layout" data-tabs><div class="faq-tabs" role="tablist" aria-label={ui(lang, 'FAQ categories', '问题分类')} aria-orientation="vertical">{faq.map((section,i)=><button role="tab" id={`faq-tab-${i}`} aria-controls={`faq-panel-${i}`} aria-selected={i===0} tabindex={i===0?0:-1}>{en?englishTitles[i]:section.title}</button>)}</div><div>{faq.map((section,i)=><section role="tabpanel" id={`faq-panel-${i}`} aria-labelledby={`faq-tab-${i}`} class="faq-panel" hidden={i!==0}><h2>{en?englishTitles[i]:section.title}</h2>{section.questions.map(item=><details><summary>{item.question}<span class="faq-expand"><Icon name="plus" /></span><span class="faq-collapse"><Icon name="minus" /></span></summary><div class="faq-answer" lang={lang === 'ja' ? 'ja' : 'zh-CN'} set:html={item.answer} /></details>)}</section>)}</div></div></div>
