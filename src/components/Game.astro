---
import Icon from './Icon.astro';
import { ui, link, type Lang } from '../lib/content';
interface Props { lang: Lang; }
const {lang}=Astro.props; ---
<section class="game-hero"><img src="/conceptsgame/img/background.png" alt="" /><div class="game-copy"><img src="/images/conceptsgame-black.png" alt="CONCEPTS GAME" /><h1 data-original-font="body">· GAME IS LIFE</h1><h2 data-original-font="body">COMING<br />SOON<span><Icon name="game" /></span></h2><p>{ui(lang, 'Concepts Game is in preparation. Stay tuned.', '概念游戏正在筹备中，敬请期待。')}</p><a class="pill-button" href={link(lang,'about')}>{ui(lang, 'About Us', '关于我们')} <Icon name="arrow" direction="up-right" /></a><p class="game-copyright" data-original-font="body">Copyright ©2023 CONCEPTS GAME / MOEQY</p></div></section>
